DATABASE_URL=""
DIRECT_DATABASE_URL=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""

# Format: pbkdf2_sha256$<iterations>$<base64url-salt>$<base64url-digest>
# Use at least 600000 PBKDF2-SHA256 iterations, a 16-byte salt and a 32-byte digest.
BREWSTACK_PASSWORD_HASH=""

# Generate at least 32 random characters; 48 random bytes are recommended.
BREWSTACK_SESSION_SECRET=""

# Used only to create the first database-backed administrator.
BREWSTACK_BOOTSTRAP_EMAIL="admin@brewstack.local"
BREWSTACK_BOOTSTRAP_NAME="BrewStack Admin"
